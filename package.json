{
    "name": "ux-portfolio",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "clean": "node scripts/clean-next.mjs",
        "sync:standalone": "node scripts/sync-standalone-assets.mjs",
        "dev": "node scripts/ensure-port-free.mjs && node scripts/update-gallery.mjs && node scripts/update-kontrast-manifest.mjs && next dev",
        "dev:clean": "node scripts/clean-next.mjs && node scripts/ensure-port-free.mjs && node scripts/update-gallery.mjs && node scripts/update-kontrast-manifest.mjs && next dev",
        "dev:force": "node scripts/update-gallery.mjs && node scripts/update-kontrast-manifest.mjs && next dev",
        "prebuild": "node scripts/print-build-start.mjs && node scripts/clean-next.mjs",
        "build": "node scripts/update-gallery.mjs && node scripts/update-kontrast-manifest.mjs && node --max-old-space-size=8192 ./node_modules/next/dist/bin/next build && node scripts/sync-standalone-assets.mjs",
        "start": "node scripts/start-standalone.mjs",
        "start:3001": "node scripts/start-standalone.mjs 3001",
        "lint": "next lint",
        "seed": "curl -X POST \"http://localhost:3000/api/seed?secret=dev-preview-secret\"",
        "typecheck": "tsc --noEmit",
        "update-images": "node scripts/update-gallery.mjs",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui"
    },
    "dependencies": {
        "@payloadcms/db-sqlite": "^3.76.1",
        "@payloadcms/next": "^3.76.1",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-toggle-group": "^1.1.1",
        "@radix-ui/react-tooltip": "^1.2.8",
        "class-variance-authority": "^0.7.1",
        "cli-color": "^2.0.4",
        "clsx": "^2.1.1",
        "framer-motion": "^12.4.2",
        "graphql": "^16.12.0",
        "lottie-react": "^2.4.1",
        "lucide-react": "^0.474.0",
        "next": "^15.4.11",
        "payload": "^3.76.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "recharts": "^3.7.0",
        "sharp": "^0.33.5",
        "tailwind-merge": "^3.0.1",
        "tailwindcss-animate": "^1.0.7",
        "typecheck": "^0.1.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^2.1.0",
        "@playwright/test": "^1.58.2",
        "@types/node": "^22.10.1",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.17.0",
        "eslint-config-next": "^15.1.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.2"
    }
}
