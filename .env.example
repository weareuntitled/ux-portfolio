# Copy to .env.local for local development (never commit real secrets).

NODE_ENV=development
PORT=3000

EDIT_MODE=true

PAYLOAD_SECRET=change-me-long-random-string
PAYLOAD_PUBLIC_URL=http://localhost:3000
PAYLOAD_DB_SQLITE_PATH=./data/payload.db
PAYLOAD_UPLOADS_DIR=./uploads

ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=change-me

PREVIEW_SECRET=change-me-preview-secret
ALLOWED_ORIGINS=http://localhost:3000

# Optional: remote image CDN
# NEXT_PUBLIC_PROJECT_ASSET_BASE=

# Optional: telemetry
# NEXT_TELEMETRY_DISABLED=1
